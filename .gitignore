## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/
packages/

# Node.js
node_modules/
package-lock.json
npm-debug.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/

# Generated documentation
**/generated/

# ApiMark generated API reference. ApiMark writes src/<project>/api/ after every build and
# packs it into the NuGet package; it is build output regenerated from the assembly and its
# XML doc comments, so it is never committed. Also excluded from markdownlint
# (.markdownlint-cli2.yaml) and cspell (.cspell.yaml) for the same reason.
src/*/api/

# Test results
TestResults/
*.trx
*.xml
coverage.opencover.xml

# Preserved failing-test TRX archive (created by build.ps1 on test failure, outside TestResults/**
# so it is never counted by the ReqStream gate); diagnostic only, not committed.
test-history/

# VersionMark captures (generated during CI/CD)
versionmark-*.json

# Temporary files
*.tmp
*.temp
*.log

# Agent report files
AGENT_REPORT_*.md
.agent-logs/

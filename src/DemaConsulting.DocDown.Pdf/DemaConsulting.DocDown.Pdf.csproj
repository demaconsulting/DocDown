<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.DocDown.Pdf</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>PDF text, embedded-image, and metadata extraction for DEMA Consulting DocDown</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/DocDown</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/DocDown</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>docdown;pdf;dotnet-library</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DocDown.Pdf</Title>
    <Product>DemaConsulting.DocDown.Pdf</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- API Documentation Configuration -->
    <!-- ApiMark writes the gradual-disclosure Markdown API reference into the project's api/
         folder after every build, and ApiMarkPackDocs places that folder inside the produced
         NuGet package so consumers (and AI agents) get the API reference with the package. The
         api/ folder is build output: it is git-ignored and excluded from markdownlint and cspell. -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
    <!-- ApiMarkOutputDir is left at ApiMark's default, $(MSBuildProjectDirectory)\api, unless a
         harness supplies ApiMarkOutputRoot. The packaging tests run 'dotnet pack' on this project
         concurrently from several processes; because the generator writes into the project
         directory, they would race on the same api/ files exactly as they once raced on the shared
         obj/Release nuspec. Passing -p:ApiMarkOutputRoot=(unique folder) gives each pack its own
         tree, and the per-project subfolder keeps a referenced project's reference out of this
         project's package. Ordinary builds set nothing and keep the default location. -->
    <ApiMarkOutputDir Condition="'$(ApiMarkOutputRoot)' != ''">$(ApiMarkOutputRoot)\$(MSBuildProjectName)\api</ApiMarkOutputDir>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Runtime Dependencies -->
  <ItemGroup>
    <!-- PdfPig is the managed PDF parser this package is built on. The version is pinned to an
         exact range because PdfPig is pre-1.0 and documents that its public API may change on a
         minor version; a floating reference would let a restore silently substitute an
         incompatible API. PdfPig is 100% managed with no native assets and no transitive
         dependencies on the target frameworks used here, which is what keeps this package
         runtime-identifier agnostic. The optional PdfPig.Filters.Dct.JpegLibrary and
         PdfPig.Filters.Jpx.OpenJpeg add-ons are deliberately not referenced; see the PdfPig
         integration design for the rationale and the honest-gap behavior that replaces them. -->
    <PackageReference Include="PdfPig" Version="[0.1.16]" />
  </ItemGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <!-- ApiMark runs as an MSBuild task after Build; it contributes no runtime assets, so
         PrivateAssets="All" keeps it out of this package's dependency graph. The version is
         pinned exactly, as PdfPig and DocumentFormat.OpenXml are, for restore determinism. -->
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="[0.5.0-beta.3]" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.DocDown.Pdf.Tests" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.DocDown.Core\DemaConsulting.DocDown.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

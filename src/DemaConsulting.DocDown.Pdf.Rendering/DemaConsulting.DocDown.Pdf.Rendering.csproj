<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.DocDown.Pdf.Rendering</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Optional PDF page rendering (rasterization) for DEMA Consulting DocDown</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/DocDown</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/DocDown</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>docdown;pdf;rendering;dotnet-library</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DocDown.Pdf.Rendering</Title>
    <Product>DemaConsulting.DocDown.Pdf.Rendering</Product>

    <!-- This is the first and only DocDown package that carries native binaries: PDFtoImage pulls
         in PDFium (native rasterizer) and SkiaSharp (native 2D backend), whose per-runtime assets
         are resolved by the consumer at restore time. The package itself declares no
         <RuntimeIdentifier>, so the produced .nupkg stays runtime-identifier agnostic and a
         framework-dependent consumer (including 'dotnet tool install -g') resolves the correct
         runtimes/<rid>/native asset from the package graph at run time. Only a self-contained
         single-file publish is RID-specific and must pass 'dotnet publish -r <rid>'; see
         docs/design/docdown-pdf-rendering.md for the native-binary consequences. Trim and AOT
         compatibility for this stack are unverified, so PublishTrimmed/AOT are deliberately left
         off (here and in the tool that references this package). -->

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- API Documentation Configuration -->
    <!-- ApiMark writes the gradual-disclosure Markdown API reference into the project's api/
         folder after every build, and ApiMarkPackDocs places that folder inside the produced
         NuGet package so consumers (and AI agents) get the API reference with the package. The
         api/ folder is build output: it is git-ignored and excluded from markdownlint and cspell. -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
    <!-- ApiMarkOutputDir is left at ApiMark's default, $(MSBuildProjectDirectory)\api, unless a
         harness supplies ApiMarkOutputRoot. The packaging tests run 'dotnet pack' on this project
         concurrently from several processes; because the generator writes into the project
         directory, they would race on the same api/ files exactly as they once raced on the shared
         obj/Release nuspec. Passing -p:ApiMarkOutputRoot=(unique folder) gives each pack its own
         tree, and the per-project subfolder keeps a referenced project's reference out of this
         project's package. Ordinary builds set nothing and keep the default location. -->
    <ApiMarkOutputDir Condition="'$(ApiMarkOutputRoot)' != ''">$(ApiMarkOutputRoot)\$(MSBuildProjectName)\api</ApiMarkOutputDir>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Runtime Dependencies -->
  <ItemGroup>
    <!-- PDFtoImage is the managed rasterization API this package is built on. It wraps PDFium (the
         native page renderer) and SkiaSharp (the native 2D/PNG-encode backend). The version is
         pinned to an exact range for the same reason DocDown.Pdf pins PdfPig: a floating reference
         could silently substitute an incompatible API or a different native ABI, and the native
         assets resolved for every runtime identifier must match the managed binding exactly.
         Unlike DocDown.Pdf, this package intentionally does carry native assets transitively
         (bblanchon.PDFium.* and SkiaSharp.NativeAssets.*); that is the whole reason it is a
         separate, opt-in package rather than part of DocDown.Pdf, which must remain fully managed
         and runtime-identifier agnostic. See docs/design/ots/pdftoimage.md for the rationale and
         the deliberate divergence from the Phase-1 plan's lean toward PdfPig.Rendering.Skia. -->
    <PackageReference Include="PDFtoImage" Version="[5.4.0]" />
  </ItemGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <!-- ApiMark runs as an MSBuild task after Build; it contributes no runtime assets, so
         PrivateAssets="All" keeps it out of this package's dependency graph. The version is
         pinned exactly, as PdfPig and DocumentFormat.OpenXml are, for restore determinism. -->
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="[0.5.0]" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.DocDown.Pdf.Rendering.Tests" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <!-- Core supplies the extractor contract and output sink. DocDown.Pdf supplies the managed
         text/embedded-image/metadata extractor this package delegates to with rendering suppressed,
         so the rendering backend is a full superset without re-implementing the managed path. -->
    <ProjectReference Include="..\DemaConsulting.DocDown.Core\DemaConsulting.DocDown.Core.csproj" />
    <ProjectReference Include="..\DemaConsulting.DocDown.Pdf\DemaConsulting.DocDown.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- The self-test probe document. It is a real Microsoft Word file, authored in that application and
       scrubbed of author metadata, embedded so the backend's self-test reads what the application
       actually emits rather than a document DocDown synthesized for itself to read. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\probe.pdf" />
  </ItemGroup>

</Project>
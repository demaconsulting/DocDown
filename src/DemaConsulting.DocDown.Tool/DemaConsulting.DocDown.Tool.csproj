<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The tool targets a single framework, unlike the libraries, which multi-target so consumers
         can reference them from any supported runtime. A PackAsTool package is executed, never
         referenced, so a second and third framework adds no reachable surface: 'dotnet tool install'
         picks one framework folder and RollForward=Major below carries the build onto later hosts.
         Multi-targeting instead duplicated the entire native stack (PDFium and SkiaSharp for every
         runtime identifier) once per framework, which is where the package's bulk came from.

         net10.0 is chosen deliberately over the lowest supported framework: installing the tool
         therefore requires a .NET 10 runtime. The libraries remain net8.0/net9.0/net10.0 so library
         consumers are unaffected by this choice; it constrains only the command-line tool. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Tool Package Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>docdown</ToolCommandName>
    <PackageId>DemaConsulting.DocDown.Tool</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>The docdown command-line tool for DEMA Consulting DocDown document extraction</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/DocDown</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/DocDown</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>docdown;dotnet-tool</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>DocDown Tool</Title>
    <Product>DemaConsulting.DocDown.Tool</Product>

    <!-- Single-file publish configuration for the per-RID release matrix. These properties are
         inert during an ordinary build and pack; they take effect only when the project is
         published with a runtime identifier and the single-file publish switches. Explicit
         registration keeps assembly trimming and single-file packaging viable because no extractor
         is discovered by reflection or assembly scanning. -->
    <RollForward>Major</RollForward>

    <!-- API Documentation Configuration -->
    <!-- ApiMark is disabled for the tool. Every type in this project is internal, so ApiMark's
         default Public visibility filter finds nothing: running
         'apimark dotnet' with the assembly and xml-doc options against the
         Release build reports "Found 0 types across 0 namespace(s)" and emits a single api.md
         containing an empty namespace table and the path-convention boilerplate. Packing that
         would ship a hollow artifact, so generation is switched off rather than enabled. The
         tool's user-facing surface is its command line, documented in the User Guide and README.
         Widening ApiMarkVisibility to expose internals was rejected: internal types are not a
         consumer contract. -->
    <DisableApiMark>true</DisableApiMark>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Runtime Dependencies -->
  <ItemGroup>
    <!-- DemaConsulting.TestResults enters the dependency graph only here, in the tool: the SelfTest
         subsystem adapts Core's dependency-free self-test records into this package's TestResults
         object model and serializes them to TRX or JUnit. DocDown.Core and DocDown.Pdf remain free
         of it, so Core keeps its zero-runtime-NuGet-dependency posture. The package is MIT-licensed
         and has no transitive runtime dependencies of its own. -->
    <PackageReference Include="DemaConsulting.TestResults" Version="1.10.0" />
  </ItemGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this tool.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.DocDown.Tool.Tests" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.DocDown.Core\DemaConsulting.DocDown.Core.csproj" />
    <ProjectReference Include="..\DemaConsulting.DocDown.Pdf\DemaConsulting.DocDown.Pdf.csproj" />
    <!-- The optional page-rendering backend. It is the only reference that carries a native stack
         (PDFium/SkiaSharp) into the tool. Adding it keeps 'dotnet tool install -g' working on every
         runtime identifier from one package (the framework-dependent tool resolves the correct
         runtimes/<rid>/native asset at run time), but a self-contained single-file publish becomes
         RID-specific and needs 'dotnet publish -r <rid>'. PublishTrimmed/AOT stay off because this
         stack's trim/AOT compatibility is unverified. -->
    <ProjectReference Include="..\DemaConsulting.DocDown.Pdf.Rendering\DemaConsulting.DocDown.Pdf.Rendering.csproj" />
    <!-- The Word, Excel, PowerPoint, and Visio backends. All are managed and runtime-identifier
         agnostic: the PowerPoint and Visio COM backends reach Microsoft Office through late-bound
         IDispatch with no interop assembly, so none adds a native asset. -->
    <ProjectReference Include="..\DemaConsulting.DocDown.Office\DemaConsulting.DocDown.Office.csproj" />
    <!-- The Word backend package. It is 100% managed and runtime-identifier agnostic, so it adds no
         native asset and does not affect the tool's publish story. -->
    
    <!-- The Visio, PowerPoint, and Excel backend packages. Each is 100% managed and
         runtime-identifier agnostic (the Visio and PowerPoint COM backends reach Microsoft Office
         through late-bound IDispatch with no interop assembly), so none adds a native asset or
         affects the tool's publish story. -->
    
    
    
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Native debug symbols and unsupported runtime identifiers are excluded from the tool package.

       Symbols: the PDFium and SkiaSharp runtime packages ship a .pdb alongside each
       runtimes/<rid>/native binary, and libSkiaSharp.pdb alone is 82-88 MB per Windows runtime
       identifier. Those symbols describe third-party native code that a DocDown stack trace never
       enters, so shipping them to every user of 'dotnet tool install' costs hundreds of megabytes
       and buys nothing. Managed symbols are unaffected: only native assets are removed, and
       IncludeSymbols above still publishes the tool's own PDBs in the companion .snupkg.

       Runtimes: SkiaSharp and PDFium between them ship natives for around twenty runtime
       identifiers, including Android, LoongArch, RISC-V, musl, x86, and arm. DocDown supports the
       three platforms it is built and tested on, so the package carries those and nothing else.
       This is an allow list rather than a deny list on purpose: a deny list silently readmits
       whatever platform a future dependency update happens to add, which is how the package grew
       unnoticed in the first place.

       The allowed set is win-x64, linux-x64, and osx-arm64 — exactly the CI matrix legs — plus the
       bare 'osx' runtime identifier. That last entry is not a fourth platform: SkiaSharp publishes
       macOS as a single fat dylib under runtimes/osx/native, which .NET's runtime-identifier
       fallback (osx-arm64 -> osx -> unix) resolves for an Apple Silicon host. Dropping it would
       leave macOS able to parse a PDF but not to rasterize one. PDFium, by contrast, does publish a
       true osx-arm64 asset, so macOS draws from both entries.

       Adding a platform means adding its runtime identifier here and a CI matrix leg that exercises
       it; the two are meant to stay in step.

       Both exclusions are enforced against the produced artifact by
       DocDownTool_Package_Nupkg_ExcludesNativeSymbolsAndUnsupportedRuntimes, so a dependency update
       that reintroduces either fails the build rather than quietly inflating the package. -->
  <PropertyGroup>
    <SupportedToolRuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx</SupportedToolRuntimeIdentifiers>
  </PropertyGroup>

  <Target Name="TrimToolPackageNativeAssets" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- Native debug symbols -->
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' And '%(ResolvedFileToPublish.AssetType)' == 'native'" />

      <!-- Natives for every runtime identifier outside the supported set. The path is normalized to
           forward slashes first so the match does not depend on the build host's separator, and each
           identifier is matched with its surrounding slashes so that, for example, 'osx' does not
           also admit 'osx-x64'. -->
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.AssetType)' == 'native' And
                   $([MSBuild]::ValueOrDefault('%(ResolvedFileToPublish.RelativePath)', '').Replace('\','/').Contains('runtimes/')) And
                   !$([MSBuild]::ValueOrDefault('%(ResolvedFileToPublish.RelativePath)', '').Replace('\','/').Contains('runtimes/win-x64/')) And
                   !$([MSBuild]::ValueOrDefault('%(ResolvedFileToPublish.RelativePath)', '').Replace('\','/').Contains('runtimes/linux-x64/')) And
                   !$([MSBuild]::ValueOrDefault('%(ResolvedFileToPublish.RelativePath)', '').Replace('\','/').Contains('runtimes/osx-arm64/')) And
                   !$([MSBuild]::ValueOrDefault('%(ResolvedFileToPublish.RelativePath)', '').Replace('\','/').Contains('runtimes/osx/'))" />
    </ItemGroup>
  </Target>

</Project>
